  "id": "com.dataco.sac.abcxyzmatrix",
  "version": "0.1.0",
  "name": "ABC/XYZ Matrix",
  "newInstancePrefix": "AbcXyzMatrix",
  "description": "ABC (revenue contribution) × XYZ (demand variability) 3×3 matrix with SKU counts, revenue share, suggested stock policy per cell and an AZ watch-list. ZAR / USD.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-abcxyzmatrix",
      "url": "/abcXyzMatrix.js",
      "integrity": "sha256-dYStaa3jj/i9fZPIcZl1zT3oU+IQqDPiV0SCRyNDRng=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-abcxyzmatrix-styling",
      "url": "/abcXyzMatrixStyling.js",
      "integrity": "sha256-h3KTvmSvdV9iodhISLEpehhQrRHeD6G6biS+xmuSx0s=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "ABC / XYZ Matrix"
    },
    "subtitle": {
      "type": "string",
      "default": "Revenue contribution × demand variability"
    },
    "aCut": {
      "type": "integer",
      "default": 80
    },
    "bCut": {
      "type": "integer",
      "default": 95
    },
    "xCut": {
      "type": "number",
      "default": 0.5
    },
    "yCut": {
      "type": "integer",
      "default": 1
    },
    "showActions": {
      "type": "boolean",
      "default": true
    },
    "showTopSkus": {
      "type": "boolean",
      "default": true
    },
    "actions": {
      "type": "string",
      "default": "Auto-replenish,Safety stock,Make to order,Auto-replenish,Review buffer,Order on demand,Automate / bulk,Periodic review,Delist candidate"
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "currencySymbol": {
      "type": "string",
      "default": ""
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "hiColor": {
      "type": "string",
      "default": "#0A6ED1"
    },
    "loColor": {
      "type": "string",
      "default": "#EEF4FB"
    },
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 480
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 SKU / article, 2 Period (week or month, for variability)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Revenue, 2 Demand units (optional — else revenue is used for variability)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}