  "id": "com.dataco.sac.storequadrant",
  "version": "0.1.0",
  "name": "Store Performance Quadrant",
  "newInstancePrefix": "StoreQuadrant",
  "description": "Store bubble scatter on two KPIs (e.g. sales per m² vs margin %), split into four labelled quadrants by medians or targets; bubble size = revenue. ZAR / USD.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-storequadrant",
      "url": "/storeQuadrant.js",
      "integrity": "sha256-t15DS1x6rjGkR6Ok5fZpyNPAXmRhD++x30BCmvxdP7A=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-storequadrant-styling",
      "url": "/storeQuadrantStyling.js",
      "integrity": "sha256-a4xlhVpFYiGPnj6qqhCgYw/PxetmkrFqbR8mKelq25Y=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Store Performance"
    },
    "subtitle": {
      "type": "string",
      "default": "Sales density vs margin, bubble = revenue"
    },
    "splitMode": {
      "type": "string",
      "default": "median"
    },
    "xTarget": {
      "type": "integer",
      "default": 0
    },
    "yTarget": {
      "type": "integer",
      "default": 0
    },
    "quadrantLabels": {
      "type": "string",
      "default": "Stars,Grow sales,Fix margin,Review"
    },
    "xFormat": {
      "type": "string",
      "default": "currency"
    },
    "yFormat": {
      "type": "string",
      "default": "pct"
    },
    "labelMode": {
      "type": "string",
      "default": "outliers"
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "currencySymbol": {
      "type": "string",
      "default": ""
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "qColors": {
      "type": "string",
      "default": "#1A9850,#0A6ED1,#E9730C,#D73027"
    },
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 480
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 Store, 2 Region / format (optional)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 X KPI, 2 Y KPI, 3 Bubble size (optional)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}