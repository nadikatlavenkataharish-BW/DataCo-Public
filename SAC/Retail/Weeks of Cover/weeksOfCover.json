  "id": "com.dataco.sac.weeksofcover",
  "version": "0.1.0",
  "name": "Weeks of Cover",
  "newInstancePrefix": "WeeksOfCover",
  "description": "Stock health by category or store: weeks of cover against a target band, plus stock value, out-of-stock % and aged stock % with exception colouring. ZAR / USD.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-weeksofcover",
      "url": "/weeksOfCover.js",
      "integrity": "sha256-2q6xOkYElNTibcG7iWaZWesggPL+bLgK1/ANItmPE2c=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-weeksofcover-styling",
      "url": "/weeksOfCoverStyling.js",
      "integrity": "sha256-b87ril3VZ0wm54awNRS+VlykLV0Ba5DkYP/9a3GB7zw=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Weeks of Cover"
    },
    "subtitle": {
      "type": "string",
      "default": "Stock health against target cover"
    },
    "minWeeks": {
      "type": "integer",
      "default": 4
    },
    "maxWeeks": {
      "type": "integer",
      "default": 8
    },
    "capWeeks": {
      "type": "integer",
      "default": 20
    },
    "sortBy": {
      "type": "string",
      "default": "risk"
    },
    "oosTarget": {
      "type": "integer",
      "default": 3
    },
    "agedTarget": {
      "type": "integer",
      "default": 10
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "currencySymbol": {
      "type": "string",
      "default": ""
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "lowColor": {
      "type": "string",
      "default": "#D73027"
    },
    "okColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "highColor": {
      "type": "string",
      "default": "#E9730C"
    },
    "bandColor": {
      "type": "string",
      "default": "#D8EFDF"
    },
    "width": {
      "type": "integer",
      "default": 960
    },
    "height": {
      "type": "integer",
      "default": 440
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Category / store / department",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Stock on hand (units), 2 Avg weekly sales (units), 3 Stock value, 4 OOS %, 5 Aged stock % (3–5 optional)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
