  "id": "com.dataco.sac.sellthroughcurve",
  "version": "0.1.0",
  "name": "Sell-through Curve",
  "newInstancePrefix": "SellThroughCurve",
  "description": "Cumulative sell-through % by week since launch per season or collection against a planned curve and end-of-life target.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-sellthroughcurve",
      "url": "/sellThroughCurve.js",
      "integrity": "sha256-gODyQjTY/clJiYLhqmRwFa6/5HTw6yB42gwA8ppzFHI=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-sellthroughcurve-styling",
      "url": "/sellThroughCurveStyling.js",
      "integrity": "sha256-zQI32DJszrNMOHzUAwNiCycpuIY/MWVsSEvQugrq8zc=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Sell-through"
    },
    "subtitle": {
      "type": "string",
      "default": "Cumulative sell-through % by week since launch"
    },
    "planCurve": {
      "type": "string",
      "default": ""
    },
    "targetST": {
      "type": "integer",
      "default": 70
    },
    "targetWeek": {
      "type": "integer",
      "default": 0
    },
    "showEndLabels": {
      "type": "boolean",
      "default": true
    },
    "palette": {
      "type": "string",
      "default": "#0A6ED1,#E9730C,#1A9850,#925ACE,#C87B00,#0F828F,#D04343,#5B738B"
    },
    "planColor": {
      "type": "string",
      "default": "#33414A"
    },
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 440
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 Season / collection, 2 Week since launch (numeric)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Units sold (weekly), 2 Units bought (receipts), 3 Planned cumulative ST % (optional)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}