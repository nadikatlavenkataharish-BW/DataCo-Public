  "id": "com.dataco.sac.bbbeemanagementcontrol",
  "version": "0.1.0",
  "name": "B-BBEE Management Control",
  "newInstancePrefix": "BbbeeManagementControl",
  "description": "B-BBEE Management Control scorecard (Generic Codes, Code 200) from HR data: black and black-female representation per management level vs compliance targets, points per indicator and total out of 19.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-bbbeemanagementcontrol",
      "url": "/bbbeeManagementControl.js",
      "integrity": "sha256-OYZ6xX3LbC8qt+fy1C/U6qCWrUoIRcsF8fLQ5BbfEtA=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-bbbeemanagementcontrol-styling",
      "url": "/bbbeeManagementControlStyling.js",
      "integrity": "sha256-fXIorsd4vUOkGuXlZ0Nq2cHEr/dxEoDCrl8A0Ku7gqg=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "B-BBEE Management Control"
    },
    "subtitle": {
      "type": "string",
      "default": "Generic Codes — Code 200 (from HR data)"
    },
    "indicators": {
      "type": "string",
      "default": "Board:2:50:1:25,Executive directors:2:50:1:25,Other executive management:2:60:1:30,Senior management:2:60:1:30,Middle management:2:75:1:38,Junior management:1:88:1:44"
    },
    "disabledPoints": {
      "type": "integer",
      "default": 2
    },
    "disabledTarget": {
      "type": "integer",
      "default": 2
    },
    "foreignLabels": {
      "type": "string",
      "default": "Foreign national,Foreign nationals,Foreign,Non-SA,Non South African"
    },
    "showNotAvailable": {
      "type": "boolean",
      "default": true
    },
    "barColor": {
      "type": "string",
      "default": "#0A6ED1"
    },
    "femaleColor": {
      "type": "string",
      "default": "#925ACE"
    },
    "goodColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "badColor": {
      "type": "string",
      "default": "#D73027"
    },
    "trackColor": {
      "type": "string",
      "default": "#EEF1F4"
    },
    "width": {
      "type": "integer",
      "default": 980
    },
    "height": {
      "type": "integer",
      "default": 520
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 B-BBEE management level, 2 Race (population group), 3 Gender, 4 Nationality / citizenship (optional)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Headcount, 2 Headcount with disability (optional)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}