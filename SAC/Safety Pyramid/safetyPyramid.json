  "vendor": "Data Co",
  "license": "Proprietary. Copyright (c) 2026 The Data Co (Pty) Ltd. All rights reserved.",
  "id": "com.dataco.sac.safetypyramid",
  "version": "0.1.0",
  "name": "Safety Pyramid",
  "newInstancePrefix": "SafetyPyramid",
  "description": "Safety triangle of incidents by severity (fatality → LTI → MTI → first aid → near miss) with LTIFR/TRIFR frequency rates when exposure hours are bound.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-safetypyramid",
      "url": "/safetyPyramid.js",
      "integrity": "sha256-BbyUMufmBm4+qRL6Xokjn84E1MIkFYjCmLzjZg5SF4o=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-safetypyramid-styling",
      "url": "/safetyPyramidStyling.js",
      "integrity": "sha256-Gt94tUwBpq7AHRpDTju1FR4F9yF3dNH/8dQtaOuw/Cg=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Safety Performance"
    },
    "subtitle": {
      "type": "string",
      "default": "Incidents by severity"
    },
    "rateBase": {
      "type": "integer",
      "default": 1000000
    },
    "ltiLevels": {
      "type": "string",
      "default": "1-2"
    },
    "trifrLevels": {
      "type": "string",
      "default": "1-3"
    },
    "ltifrTarget": {
      "type": "integer",
      "default": 1
    },
    "trifrTarget": {
      "type": "integer",
      "default": 5
    },
    "showRatio": {
      "type": "boolean",
      "default": true
    },
    "showRates": {
      "type": "boolean",
      "default": true
    },
    "levelColors": {
      "type": "string",
      "default": "#7F1D1D,#B91C1C,#E9730C,#E0A100,#8FB3D9,#C9D7E6"
    },
    "goodColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "badColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 820
    },
    "height": {
      "type": "integer",
      "default": 420
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Site / period (optional — values are summed)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Incident counts from most to least severe; a measure named '…hours…' is used as exposure",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}