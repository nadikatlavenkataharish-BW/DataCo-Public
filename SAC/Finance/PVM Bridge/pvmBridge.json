  "id": "com.dataco.sac.pvmbridge",
  "version": "0.1.0",
  "name": "Price-Volume-Mix Bridge",
  "newInstancePrefix": "PvmBridge",
  "description": "Revenue bridge from prior to current period split into volume, mix, price and new/discontinued effects, computed per product, with the top product drivers. ZAR / USD.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-pvmbridge",
      "url": "/pvmBridge.js",
      "integrity": "sha256-mEhMz048dKjt4mDePpuuc1OQiDQFsXaQ5EaKz0jf/Yo=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-pvmbridge-styling",
      "url": "/pvmBridgeStyling.js",
      "integrity": "sha256-5inuJJC1xZf0cmxOLIrDu7ub0urfZVDhhwraKjSpC/c=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Price-Volume-Mix"
    },
    "subtitle": {
      "type": "string",
      "default": "Revenue bridge, prior period to current"
    },
    "priorLabel": {
      "type": "string",
      "default": "Prior period"
    },
    "currentLabel": {
      "type": "string",
      "default": "Current period"
    },
    "showDrivers": {
      "type": "boolean",
      "default": true
    },
    "topDrivers": {
      "type": "integer",
      "default": 6
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "currencySymbol": {
      "type": "string",
      "default": ""
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "totalColor": {
      "type": "string",
      "default": "#5B738B"
    },
    "positiveColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "negativeColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 1000
    },
    "height": {
      "type": "integer",
      "default": 420
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Product / SKU / customer",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Units PY, 2 Revenue PY, 3 Units CY, 4 Revenue CY",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}