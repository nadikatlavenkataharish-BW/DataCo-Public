  "id": "com.dataco.sac.pnlwaterfall",
  "version": "0.1.0",
  "name": "P&L Waterfall",
  "newInstancePrefix": "PnlWaterfall",
  "description": "Income-statement waterfall from revenue to net profit with automatic sub-total bars (Gross profit, EBITDA, EBIT …) and % of revenue labels. ZAR / USD.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-pnlwaterfall",
      "url": "/pnlWaterfall.js",
      "integrity": "sha256-ivU5l5Y3NL7CMdMSHDZhTIQN5SQnBXhQxOJwXqr5Aro=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-pnlwaterfall-styling",
      "url": "/pnlWaterfallStyling.js",
      "integrity": "sha256-/a5yNbowETEkkIy19NywvtHbOPCq3rfa2I8PlxfbeBA=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Income Statement"
    },
    "subtitle": {
      "type": "string",
      "default": "Revenue to net profit"
    },
    "costSign": {
      "type": "string",
      "default": "positive"
    },
    "revenueLines": {
      "type": "string",
      "default": ""
    },
    "totalLines": {
      "type": "string",
      "default": "Gross profit,EBITDA,EBIT,Profit before tax,Net profit"
    },
    "insertTotals": {
      "type": "string",
      "default": ""
    },
    "finalLabel": {
      "type": "string",
      "default": "Net profit"
    },
    "showPctOfRevenue": {
      "type": "boolean",
      "default": true
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "currencySymbol": {
      "type": "string",
      "default": ""
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "revenueColor": {
      "type": "string",
      "default": "#5B738B"
    },
    "totalColor": {
      "type": "string",
      "default": "#33414A"
    },
    "positiveColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "negativeColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 1000
    },
    "height": {
      "type": "integer",
      "default": 440
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "P&L line / account node (in statement order)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Amount",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}