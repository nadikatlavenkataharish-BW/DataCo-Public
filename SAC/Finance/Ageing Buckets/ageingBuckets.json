  "id": "com.dataco.sac.ageingbuckets",
  "version": "0.1.0",
  "name": "Ageing Buckets (AR/AP)",
  "newInstancePrefix": "AgeingBuckets",
  "description": "Debtors / creditors ageing: stacked bars per customer or vendor across ageing buckets, Top-N + Other, with total, overdue and oldest-bucket tiles. ZAR / USD.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-ageingbuckets",
      "url": "/ageingBuckets.js",
      "integrity": "sha256-QQ+aFz/tzuzDrb1sf8e2mZptUjyfVQkRynjFrAHwo3U=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-ageingbuckets-styling",
      "url": "/ageingBucketsStyling.js",
      "integrity": "sha256-D5gaQgC9xsv1bWEm29QBwH1D0h1NYVmBJBWMSQSvaIQ=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Debtors Ageing"
    },
    "subtitle": {
      "type": "string",
      "default": "Outstanding balance by days overdue"
    },
    "topN": {
      "type": "integer",
      "default": 10
    },
    "sortBy": {
      "type": "string",
      "default": "overdue"
    },
    "currentBuckets": {
      "type": "integer",
      "default": 1
    },
    "showTiles": {
      "type": "boolean",
      "default": true
    },
    "showPct": {
      "type": "boolean",
      "default": true
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "currencySymbol": {
      "type": "string",
      "default": ""
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "bucketColors": {
      "type": "string",
      "default": "#1A9850,#A6D96A,#FEE08B,#FDAE61,#F46D43,#D73027"
    },
    "width": {
      "type": "integer",
      "default": 960
    },
    "height": {
      "type": "integer",
      "default": 460
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Customer / vendor",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Ageing buckets in order, current first (e.g. Current, 1-30, 31-60, 61-90, 90+)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}