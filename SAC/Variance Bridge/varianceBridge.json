{
  "eula": "",
  "vendor": "Data Co",
  "license": "",
  "id": "com.dataco.sac.variancebridge",
  "version": "0.1.0",
  "name": "Variance Bridge",
  "newInstancePrefix": "VarianceBridge",
  "description": "Plan-to-Actual waterfall: one floating bar per driver (Actual − Plan), sorted by impact with Top-N + Other, favourable/unfavourable colouring.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-variancebridge",
      "url": "/varianceBridge.js",
      "integrity": "sha256-FgSr9m2W0LjLFjzTZHeDBZmjLT+LMU5FinX2Ue9XrbQ=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-variancebridge-styling",
      "url": "/varianceBridgeStyling.js",
      "integrity": "sha256-WKy3J66DoCjHASXk5PaP7jr5rkNaxHFOLa7Y5tJ6wI8=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Variance Bridge"
    },
    "subtitle": {
      "type": "string",
      "default": "Plan to Actual by driver"
    },
    "topN": {
      "type": "integer",
      "default": 8
    },
    "sortBy": {
      "type": "string",
      "default": "abs"
    },
    "invertSign": {
      "type": "boolean",
      "default": false
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": ""
    },
    "showValues": {
      "type": "boolean",
      "default": true
    },
    "showConnectors": {
      "type": "boolean",
      "default": true
    },
    "totalColor": {
      "type": "string",
      "default": "#5B738B"
    },
    "goodColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "badColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 420
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Driver (site, cost element, product …)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Actual, 2 Plan",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}