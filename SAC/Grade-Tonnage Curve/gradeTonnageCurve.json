  "id": "com.dataco.sac.gradetonnagecurve",
  "version": "0.1.0",
  "name": "Grade-Tonnage Curve",
  "newInstancePrefix": "GradeTonnageCurve",
  "description": "Grade-tonnage curve from block-model grade bins: tonnes and average grade above cut-off on twin axes, with a cut-off read-out of tonnes, grade and contained metal.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-gradetonnagecurve",
      "url": "/gradeTonnageCurve.js",
      "integrity": "sha256-JVOOcmpd//I4G0Dq09UTJnKRQGReklZHVnLtW750ijU=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-gradetonnagecurve-styling",
      "url": "/gradeTonnageCurveStyling.js",
      "integrity": "sha256-9K9xU03XzcJCz/nGMJhdsRNNRM9k+xAH9GZq5h8OIec=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Grade–Tonnage Curve"
    },
    "subtitle": {
      "type": "string",
      "default": "Tonnes and average grade above cut-off"
    },
    "cutoff": {
      "type": "number",
      "default": 0.3
    },
    "gradeUnit": {
      "type": "string",
      "default": "% Cu"
    },
    "gradeDecimals": {
      "type": "integer",
      "default": 2
    },
    "metalFactor": {
      "type": "number",
      "default": 0.01
    },
    "metalUnit": {
      "type": "string",
      "default": "t Cu"
    },
    "showMetal": {
      "type": "boolean",
      "default": true
    },
    "showArea": {
      "type": "boolean",
      "default": true
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": " t"
    },
    "tonnesColor": {
      "type": "string",
      "default": "#0A6ED1"
    },
    "gradeColor": {
      "type": "string",
      "default": "#E9730C"
    },
    "cutoffColor": {
      "type": "string",
      "default": "#33414A"
    },
    "width": {
      "type": "integer",
      "default": 860
    },
    "height": {
      "type": "integer",
      "default": 420
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Grade bin / class (numeric label, e.g. 0.30)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Tonnes, 2 Bin grade (optional — else parsed from the bin label)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}