{
  "eula": "",
  "vendor": "Data Co",
  "license": "",
  "id": "com.dataco.sac.varianceheatmap",
  "version": "0.1.0",
  "name": "Variance Heatmap",
  "newInstancePrefix": "VarianceHeatmap",
  "description": "Row × column heatmap coloured by variance % (or abs) vs plan with continuous or RAG thresholds, row/column totals; falls back to a value heatmap with one measure.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-varianceheatmap",
      "url": "/varianceHeatmap.js",
      "integrity": "sha256-LaCB+1BF1KEY5gN+dzl/PexltJ3+x2NaHG6+FVaHtd8=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-varianceheatmap-styling",
      "url": "/varianceHeatmapStyling.js",
      "integrity": "sha256-Gtm8RlMkwQkN9fU6Wz3WSPxOmE0baLjRVz19x5xWKJ4=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Variance Heatmap"
    },
    "subtitle": {
      "type": "string",
      "default": "Variance % vs plan"
    },
    "mode": {
      "type": "string",
      "default": "variancePct"
    },
    "colorMode": {
      "type": "string",
      "default": "continuous"
    },
    "thresholdBad": {
      "type": "integer",
      "default": -5
    },
    "thresholdGood": {
      "type": "integer",
      "default": 5
    },
    "invertSign": {
      "type": "boolean",
      "default": false
    },
    "showValues": {
      "type": "boolean",
      "default": true
    },
    "showTotals": {
      "type": "boolean",
      "default": true
    },
    "cellHeight": {
      "type": "integer",
      "default": 30
    },
    "labelWidth": {
      "type": "integer",
      "default": 130
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": ""
    },
    "goodColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "midColor": {
      "type": "string",
      "default": "#F7F7F2"
    },
    "badColor": {
      "type": "string",
      "default": "#D73027"
    },
    "amberColor": {
      "type": "string",
      "default": "#F4C542"
    },
    "emptyColor": {
      "type": "string",
      "default": "#EEF1F4"
    },
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 400
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 Rows (e.g. Site), 2 Columns (e.g. Period)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Actual, 2 Plan (optional — without it, values are shown)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}