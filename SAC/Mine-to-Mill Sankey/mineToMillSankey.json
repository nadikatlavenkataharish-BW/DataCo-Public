      "integrity": "sha256-maDuDd5jxdiv/dj909ggyWafWiivNJF/qv2C5mqwWfo=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Mine-to-Mill Flow"
    },
    "subtitle": {
      "type": "string",
      "default": "Tonnes by stage"
    },
    "colorBy": {
      "type": "string",
      "default": "source"
    },
    "nodeWidth": {
      "type": "integer",
      "default": 14
    },
    "nodePadding": {
      "type": "integer",
      "default": 18
    },
    "showValues": {
      "type": "boolean",
      "default": true
    },
    "showLosses": {
      "type": "boolean",
      "default": true
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": " t"
    },
    "gradeUnit": {
      "type": "string",
      "default": "% Cu"
    },
    "gradeDecimals": {
      "type": "integer",
      "default": 2
    },
    "palette": {
      "type": "string",
      "default": "#0A6ED1,#E9730C,#5B738B,#1A9850,#925ACE,#C87B00,#0F828F,#D04343"
    },
    "gradeLow": {
      "type": "string",
      "default": "#D73027"
    },
    "gradeMid": {
      "type": "string",
      "default": "#FEE08B"
    },
    "gradeHigh": {
      "type": "string",
      "default": "#1A9850"
    },
    "nodeColor": {
      "type": "string",
      "default": "#33414A"
    },
    "lossColor": {
      "type": "string",
      "default": "#C4CDD5"
    },
    "width": {
      "type": "integer",
      "default": 960
    },
    "height": {
      "type": "integer",
      "default": 440
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 Source node, 2 Target node",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Tonnes, 2 Grade (optional)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
