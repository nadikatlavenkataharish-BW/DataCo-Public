  "name": "Mine-to-Mill Sankey",
  "newInstancePrefix": "MineToMillSankey",
  "description": "Material-flow Sankey from pits/stopes through stockpiles, crusher and mill to concentrate and tailings; link width = tonnes, optional grade colouring, loss stubs.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-minetomillsankey",
      "url": "/mineToMillSankey.js",
      "integrity": "sha256-9GQEKOUQ9uGLmO9nUQMVGbQPgQzamyc4P+XGdhRoqn8=",
      "ignoreIntegrity": true
    },
    {
