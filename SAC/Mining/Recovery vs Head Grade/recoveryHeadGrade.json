  "id": "com.dataco.sac.recoveryheadgrade",
  "version": "0.1.0",
  "name": "Recovery vs Head Grade",
  "newInstancePrefix": "RecoveryHeadGrade",
  "description": "Scatter of plant recovery against head grade per day/shift with log or linear fit, R², target band and below-band count.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-recoveryheadgrade",
      "url": "/recoveryHeadGrade.js",
      "integrity": "sha256-SYimGqeaF/rk8Nm4jE/ymt1JK27NJmxK9tTcOWpsMJk=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-recoveryheadgrade-styling",
      "url": "/recoveryHeadGradeStyling.js",
      "integrity": "sha256-hyDTYL0SvEIjbdJPWfc/uduitMYE7YozSuhbHAlR7wU=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Recovery vs Head Grade"
    },
    "subtitle": {
      "type": "string",
      "default": "Plant recovery by feed grade"
    },
    "fitType": {
      "type": "string",
      "default": "log"
    },
    "targetRecovery": {
      "type": "integer",
      "default": 88
    },
    "targetBand": {
      "type": "integer",
      "default": 2
    },
    "recoveryScale": {
      "type": "string",
      "default": "auto"
    },
    "colorBy": {
      "type": "string",
      "default": "band"
    },
    "gradeUnit": {
      "type": "string",
      "default": "% Cu"
    },
    "gradeDecimals": {
      "type": "integer",
      "default": 2
    },
    "pointColor": {
      "type": "string",
      "default": "#0A6ED1"
    },
    "belowColor": {
      "type": "string",
      "default": "#D73027"
    },
    "aboveColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "palette": {
      "type": "string",
      "default": "#0A6ED1,#E9730C,#1A9850,#925ACE,#C87B00,#0F828F,#D04343,#5B738B"
    },
    "fitColor": {
      "type": "string",
      "default": "#33414A"
    },
    "bandColor": {
      "type": "string",
      "default": "#D8EFDF"
    },
    "showStats": {
      "type": "boolean",
      "default": true
    },
    "pointSize": {
      "type": "integer",
      "default": 4
    },
    "width": {
      "type": "integer",
      "default": 820
    },
    "height": {
      "type": "integer",
      "default": 440
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 Point (day/shift), 2 Group/colour (optional)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Head grade, 2 Recovery (% or fraction)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}