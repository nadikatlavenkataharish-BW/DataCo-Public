  "id": "com.dataco.sac.oeetimeusage",
  "version": "0.1.0",
  "name": "OEE Time-Usage Waterfall",
  "newInstancePrefix": "OeeTimeUsage",
  "description": "Time-usage waterfall from calendar hours through scheduled/unscheduled down, standby and delays to direct operating hours, with Availability, Utilisation, Efficiency and OEE tiles.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-oeetimeusage",
      "url": "/oeeTimeUsage.js",
      "integrity": "sha256-vP+xRtK85l8FYwzkD1DQFW0F2ikUNL8e0tRQmdEQ+DI=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-oeetimeusage-styling",
      "url": "/oeeTimeUsageStyling.js",
      "integrity": "sha256-x6atXZCv04FHIX19hrAqTyUIfkeDRj0+ArfS72ESPTY=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Time Usage & OEE"
    },
    "subtitle": {
      "type": "string",
      "default": "Calendar hours to direct operating hours"
    },
    "lossTypes": {
      "type": "string",
      "default": "SD,UD,SB,OD"
    },
    "availTarget": {
      "type": "integer",
      "default": 85
    },
    "utilTarget": {
      "type": "integer",
      "default": 85
    },
    "effTarget": {
      "type": "integer",
      "default": 90
    },
    "oeeTarget": {
      "type": "integer",
      "default": 65
    },
    "showSubtotals": {
      "type": "boolean",
      "default": true
    },
    "showKpis": {
      "type": "boolean",
      "default": true
    },
    "valueScale": {
      "type": "string",
      "default": "none"
    },
    "decimals": {
      "type": "integer",
      "default": 0
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": " h"
    },
    "totalColor": {
      "type": "string",
      "default": "#5B738B"
    },
    "sdColor": {
      "type": "string",
      "default": "#8794A0"
    },
    "udColor": {
      "type": "string",
      "default": "#D73027"
    },
    "sbColor": {
      "type": "string",
      "default": "#E0A100"
    },
    "odColor": {
      "type": "string",
      "default": "#E9730C"
    },
    "plColor": {
      "type": "string",
      "default": "#925ACE"
    },
    "goodColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "badColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 960
    },
    "height": {
      "type": "integer",
      "default": 420
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Equipment / fleet (optional — values are summed)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Calendar hours, then loss hours matching lossTypes (e.g. SD, UD, SB, OD)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}