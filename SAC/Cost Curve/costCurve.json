{
  "eula": "",
  "vendor": "Data Co",
  "license": "",
  "id": "com.dataco.sac.costcurve",
  "version": "0.1.0",
  "name": "Cost Curve",
  "newInstancePrefix": "CostCurve",
  "description": "Industry cost curve: operations sorted by unit cost, bar width = production, with highlighted own assets, quartile markers and a price line.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-costcurve",
      "url": "/costCurve.js",
      "integrity": "sha256-91dPpguOrBa01nSGCcubudnYFQ2LFCXZjnMV2vJ4AbQ=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-costcurve-styling",
      "url": "/costCurveStyling.js",
      "integrity": "sha256-DEeaDyRAxCCX53m1BQwxYPBIeDkbSuRH39j3p5znV90=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Cost Curve"
    },
    "subtitle": {
      "type": "string",
      "default": "C1 cash cost vs cumulative production"
    },
    "highlight": {
      "type": "string",
      "default": ""
    },
    "highlightGroup": {
      "type": "string",
      "default": ""
    },
    "price": {
      "type": "integer",
      "default": 0
    },
    "priceLabel": {
      "type": "string",
      "default": "Price"
    },
    "showQuartiles": {
      "type": "boolean",
      "default": true
    },
    "showLabels": {
      "type": "string",
      "default": "highlight"
    },
    "costPrefix": {
      "type": "string",
      "default": "US$"
    },
    "costSuffix": {
      "type": "string",
      "default": "/lb"
    },
    "costDecimals": {
      "type": "integer",
      "default": 2
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 0
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": " kt"
    },
    "baseColor": {
      "type": "string",
      "default": "#C4CDD5"
    },
    "highlightColor": {
      "type": "string",
      "default": "#0A6ED1"
    },
    "priceColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 960
    },
    "height": {
      "type": "integer",
      "default": 420
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Dimensions in order: 1 Operation, 2 Owner/group (optional, for highlightGroup)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Production, 2 Unit cost",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}