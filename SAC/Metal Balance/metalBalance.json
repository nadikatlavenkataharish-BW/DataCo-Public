{
  "eula": "",
  "vendor": "Data Co",
  "license": "",
  "id": "com.dataco.sac.metalbalance",
  "version": "0.1.0",
  "name": "Metal Balance & Reconciliation",
  "newInstancePrefix": "MetalBalance",
  "description": "Metal balance across stages (model → grade control → mill → product) with an F-factor matrix for tonnes, grade and metal, coloured against reconciliation tolerances.",
  "icon": "data:image/png;base64,",
  "supportsMobile": true,
  "supportsBookmark": true,
  "supportsExport": true,
  "supportsLinkedAnalysisFilterOnSelection": false,
  "webcomponents": [
    {
      "kind": "main",
      "tag": "com-dataco-sac-metalbalance",
      "url": "/metalBalance.js",
      "integrity": "sha256-wDJgL0HSPgpwxUQPvgKUI2lOOceGix1QbW3EH74AdvI=",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "com-dataco-sac-metalbalance-styling",
      "url": "/metalBalanceStyling.js",
      "integrity": "sha256-Z7y7aHsKiTgzw+5xEY12Bj9MAELj/Ie5TFtzwYiwPd0=",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "title": {
      "type": "string",
      "default": "Metal Balance & Reconciliation"
    },
    "subtitle": {
      "type": "string",
      "default": "F-factors by stage"
    },
    "gradeUnit": {
      "type": "string",
      "default": "% Cu"
    },
    "gradeDecimals": {
      "type": "integer",
      "default": 2
    },
    "metalFactor": {
      "type": "number",
      "default": 0.01
    },
    "metalUnit": {
      "type": "string",
      "default": "t Cu"
    },
    "tolerance": {
      "type": "integer",
      "default": 5
    },
    "warnTolerance": {
      "type": "integer",
      "default": 10
    },
    "showOverall": {
      "type": "boolean",
      "default": true
    },
    "valueScale": {
      "type": "string",
      "default": "auto"
    },
    "decimals": {
      "type": "integer",
      "default": 1
    },
    "prefix": {
      "type": "string",
      "default": ""
    },
    "suffix": {
      "type": "string",
      "default": " t"
    },
    "barColor": {
      "type": "string",
      "default": "#5B738B"
    },
    "goodColor": {
      "type": "string",
      "default": "#1A9850"
    },
    "amberColor": {
      "type": "string",
      "default": "#E0A100"
    },
    "badColor": {
      "type": "string",
      "default": "#D73027"
    },
    "width": {
      "type": "integer",
      "default": 900
    },
    "height": {
      "type": "integer",
      "default": 460
    },
    "stageOrder": {
      "type": "string",
      "default": ""
    }
  },
  "dataBindings": {
    "dataBinding": {
      "feeds": [
        {
          "id": "dimensions",
          "description": "Stage (e.g. Reserve model, Grade control, Mill, Product)",
          "type": "dimension"
        },
        {
          "id": "measures",
          "description": "Measures in order: 1 Tonnes, 2 Grade, 3 Metal (optional — else t × grade × factor)",
          "type": "mainStructureMember"
        }
      ]
    }
  },
  "methods": {
    "getDataSource": {
      "parameters": [],
      "body": "return this.dataBindings.getDataBinding('dataBinding').getDataSource();",
      "returnType": "DataSource"
    },
    "openSelectModelDialog": {
      "parameters": [],
      "body": "this.dataBindings.getDataBinding('dataBinding').openSelectModelDialog();"
    }
  },
  "events": {
    "onResultChanged": {
      "description": "Fired when the widget result set changes."
    }
  }
}